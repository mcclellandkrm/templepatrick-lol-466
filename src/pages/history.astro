---
import Layout from '../layouts/Layout.astro';
import historyData from '../data/history.json';
---

<Layout
  title="History & Heritage | Templepatrick L.O.L. No. 466"
  description="Chronicles of Templepatrick, Castle Upton, Six Mile Water, Patterson's Spade Mill, and Dr. Lavinia Loughridge."
  currentPath="/history"
>

  <!-- Page Header Banner -->
  <section class="bg-[#141417] text-white py-16 border-b border-[#C85A17]/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4 text-center md:text-left">
      <div class="inline-block px-3 py-1 bg-[#C85A17]/20 border border-[#C85A17]/40 text-[#C85A17] text-xs font-semibold uppercase tracking-widest rounded">
        Local History & Archival Collection
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-white">
        History & Heritage of Templepatrick
      </h1>
      <p class="text-base md:text-lg text-gray-300 max-w-3xl font-light">
        Centuries of agriculture, architecture, industrial craft, musical tradition, and service in the Six Mile Water valley of County Antrim.
      </p>
    </div>
  </section>

  <!-- Story Showcase Section -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Feature Images Grid with Authentic Photography -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      
      <div class="relative rounded-lg overflow-hidden border border-[#E4E4E8] shadow-sm group">
        <img
          src="/images/Templepatrick_banner_1.jpg"
          alt="Templepatrick L.O.L. 466 Banner"
          class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#1A1A1E] via-transparent to-transparent opacity-80"></div>
        <div class="absolute bottom-4 left-4 right-4 text-white">
          <span class="text-[10px] uppercase font-bold tracking-widest text-[#C85A17] bg-[#1A1A1E] px-2 py-0.5 rounded">
            Lodge Heritage
          </span>
          <h3 class="font-serif text-xl font-bold mt-1">L.O.L. No. 466 Banner</h3>
          <p class="text-xs text-gray-300 mt-0.5">Historic Lodge Banner & Brotherhood</p>
        </div>
      </div>

      <div class="relative rounded-lg overflow-hidden border border-[#E4E4E8] shadow-sm group">
        <img
          src="/images/mojor_sinclair_memorial_pipe_band.jpg"
          alt="Major Sinclair Memorial Pipe Band"
          class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#1A1A1E] via-transparent to-transparent opacity-80"></div>
        <div class="absolute bottom-4 left-4 right-4 text-white">
          <span class="text-[10px] uppercase font-bold tracking-widest text-[#C85A17] bg-[#1A1A1E] px-2 py-0.5 rounded">
            Musical Tradition
          </span>
          <h3 class="font-serif text-xl font-bold mt-1">Major Sinclair Pipe Band</h3>
          <p class="text-xs text-gray-300 mt-0.5">County Antrim Musical Heritage</p>
        </div>
      </div>

      <div class="relative rounded-lg overflow-hidden border border-[#E4E4E8] shadow-sm group">
        <img
          src="/images/arch.jpg"
          alt="Orange Arch Templepatrick"
          class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#1A1A1E] via-transparent to-transparent opacity-80"></div>
        <div class="absolute bottom-4 left-4 right-4 text-white">
          <span class="text-[10px] uppercase font-bold tracking-widest text-[#C85A17] bg-[#1A1A1E] px-2 py-0.5 rounded">
            District Landmarks
          </span>
          <h3 class="font-serif text-xl font-bold mt-1">Templepatrick District Arch</h3>
          <p class="text-xs text-gray-300 mt-0.5">Annual Cultural Celebrations</p>
        </div>
      </div>

    </div>

    <!-- Timeline & Narrative List -->
    <div class="space-y-12">
      <div class="border-b border-[#E4E4E8] pb-4">
        <h2 class="font-serif text-3xl font-bold text-[#1A1A1E]">
          Historical Chronicles & Local Figures
        </h2>
        <p class="text-sm text-[#5A5A62] mt-1">
          Explore key milestones, landmark sites, and pioneering figures connected to Templepatrick and District No. 466.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-10">
        {historyData.map((item, idx) => (
          <article class="bg-white border border-[#E4E4E8] rounded-lg p-6 md:p-8 hover:border-[#C85A17] transition-all shadow-sm flex flex-col md:flex-row gap-6 items-start">
            
            <!-- Left Year Badge Column -->
            <div class="md:w-48 shrink-0 space-y-1">
              <span class="inline-block px-3 py-1 bg-[#FDF6F0] text-[#C85A17] border border-[#C85A17]/30 text-xs font-bold uppercase tracking-wider rounded">
                {item.category}
              </span>
              <div class="font-serif text-3xl md:text-4xl font-bold text-[#1A1A1E]">
                {item.year}
              </div>
              <div class="text-xs text-[#5A5A62] font-medium">
                {item.period}
              </div>
            </div>

            <!-- Right Story Content -->
            <div class="flex-grow space-y-3">
              <div>
                <h3 class="font-serif text-2xl font-bold text-[#1A1A1E]">
                  {item.title}
                </h3>
                <h4 class="text-xs uppercase tracking-widest text-[#C85A17] font-semibold mt-0.5">
                  {item.subtitle}
                </h4>
              </div>

              <p class="text-sm font-semibold text-[#1A1A1E] leading-relaxed">
                {item.summary}
              </p>

              <p class="text-xs md:text-sm text-[#5A5A62] leading-relaxed">
                {item.content}
              </p>

              <!-- Tags -->
              <div class="pt-3 flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <span class="text-[10px] font-medium text-[#1A1A1E] bg-[#F0F0F4] px-2.5 py-1 rounded">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>

          </article>
        ))}
      </div>

    </div>

  </section>

</Layout>
