---
import Layout from '../layouts/Layout.astro';
import historyData from '../data/history.json';
import rollData from '../data/rollOfHonour.json';

const featuredHistory = historyData.slice(0, 3);
---

<Layout title="Templepatrick L.O.L. No. 466 | War Memorial Orange Hall" currentPath="/">
  
  <!-- Minimalist Hero Section -->
  <section class="relative bg-[#141417] text-white overflow-hidden py-16 md:py-24 border-b border-[#C85A17]/30">
    <!-- Subtle Background Pattern -->
    <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#C85A17_1px,transparent_1px)] [background-size:24px_24px]"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Editorial Text Content (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-[#C85A17]/15 border border-[#C85A17]/30 text-[#C85A17] text-xs uppercase tracking-widest font-semibold">
            <span class="w-2 h-2 rounded-full bg-[#C85A17] animate-ping"></span>
            County Antrim • District No. 466
          </div>

          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.15]">
            Templepatrick Loyal Orange Lodge <span class="text-[#C85A17]">No. 466</span>
          </h1>

          <p class="text-lg md:text-xl text-gray-300 font-light leading-relaxed max-w-2xl">
            Guardian of local heritage, Christian fellowship, and remembrance in the Six Mile Water valley since 1923. Home to the historic Templepatrick War Memorial Orange Hall.
          </p>

          <!-- CTAs & Action buttons -->
          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a
              href="/history"
              class="px-6 py-3.5 bg-[#C85A17] hover:bg-[#A64710] text-white font-semibold uppercase tracking-wider text-xs rounded transition-all shadow-md flex items-center gap-2"
            >
              <span>Explore Our Heritage</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>

            <a
              href="/roll-of-honour"
              class="px-6 py-3.5 bg-white/10 hover:bg-white/20 text-white font-semibold uppercase tracking-wider text-xs rounded border border-white/20 transition-all flex items-center gap-2"
            >
              <span>Roll of Honour</span>
            </a>
          </div>

          <!-- Quick Stats Row -->
          <div class="pt-8 border-t border-gray-800 grid grid-cols-3 gap-6 text-left">
            <div>
              <span class="block font-serif text-2xl md:text-3xl font-bold text-[#C85A17]">1923</span>
              <span class="text-[11px] uppercase tracking-wider text-gray-400">War Memorial Hall Built</span>
            </div>
            <div>
              <span class="block font-serif text-2xl md:text-3xl font-bold text-white">100+</span>
              <span class="text-[11px] uppercase tracking-wider text-gray-400">Years of Heritage</span>
            </div>
            <div>
              <span class="block font-serif text-2xl md:text-3xl font-bold text-white">{rollData.length}</span>
              <span class="text-[11px] uppercase tracking-wider text-gray-400">Honoured Veterans</span>
            </div>
          </div>

        </div>

        <!-- Right Hero Image Display (5 cols) -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-lg overflow-hidden border-2 border-[#C85A17]/40 shadow-2xl group">
            <img
              src="/images/memorial_hall.jpg"
              alt="Templepatrick War Memorial Orange Hall"
              class="w-full h-[420px] object-cover object-center transform group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#141417] via-transparent to-transparent opacity-75"></div>
            <div class="absolute bottom-4 left-4 right-4 p-4 bg-[#141417]/90 backdrop-blur-md rounded border border-white/10 text-xs">
              <p class="font-serif font-bold text-white">Templepatrick War Memorial Orange Hall</p>
              <p class="text-gray-400 text-[11px]">Antrim Road, Templepatrick • Co. Antrim</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Memorial Quote Section (High Editorial Impact) -->
  <section class="py-16 md:py-20 bg-[#F9F9FB] border-b border-[#E4E4E8]">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="w-12 h-0.5 bg-[#C85A17] mx-auto mb-6"></div>
      
      <blockquote class="font-serif text-2xl md:text-3xl lg:text-4xl text-[#1A1A1E] font-medium leading-tight italic">
        "These do not need our praise or tears;<br class="hidden sm:inline"/>
        They are too high for our low praise;<br class="hidden sm:inline"/>
        In equal rank with standard-bearers;<br class="hidden sm:inline"/>
        Of all the world's heroic days."
      </blockquote>

      <div class="mt-6 flex flex-col items-center justify-center space-y-1">
        <span class="text-xs uppercase tracking-widest text-[#C85A17] font-bold">
          In Solemn Remembrance
        </span>
        <span class="text-xs text-[#5A5A62]">
          Dedicated to the men and women of Templepatrick & District who served
        </span>
      </div>
    </div>
  </section>

  <!-- 3 Summary Pillar Cards (History, Roll of Honour, Hall Hire) -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <h2 class="text-xs uppercase tracking-widest text-[#C85A17] font-semibold">
        Explore Our Lodge & Community
      </h2>
      <p class="font-serif text-3xl md:text-4xl font-bold text-[#1A1A1E]">
        Pillars of Heritage & Civic Duty
      </p>
      <p class="text-sm text-[#5A5A62]">
        Discover the storied past of Templepatrick, honor our local veterans, or reserve our historic community hall.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Card 1: History & Heritage -->
      <div class="bg-white border border-[#E4E4E8] rounded-lg overflow-hidden hover:border-[#C85A17] transition-all duration-300 shadow-sm hover:shadow-lg flex flex-col justify-between group">
        <div>
          <div class="h-52 overflow-hidden relative">
            <img
              src="/images/Templepatrick_LOL.jpg"
              alt="Templepatrick L.O.L. 466 Lodge & Banner"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-3 left-3 px-3 py-1 bg-[#1A1A1E] text-white text-[10px] uppercase font-bold tracking-wider rounded">
              Lodge Heritage
            </span>
          </div>
          <div class="p-6 space-y-3">
            <h3 class="font-serif text-xl font-bold text-[#1A1A1E] group-hover:text-[#C85A17] transition-colors">
              History & Heritage
            </h3>
            <p class="text-xs text-[#5A5A62] leading-relaxed">
              Explore the rich history of Templepatrick, from Castle Upton and the Six Mile Water valley to Patterson's Spade Mill and our century of lodge brotherhood.
            </p>
          </div>
        </div>

        <div class="px-6 pb-6 pt-2">
          <a
            href="/history"
            class="inline-flex items-center text-xs font-bold uppercase tracking-wider text-[#C85A17] hover:text-[#A64710] gap-1.5"
          >
            <span>Read Timeline & Stories</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Card 2: Roll of Honour -->
      <div class="bg-white border border-[#E4E4E8] rounded-lg overflow-hidden hover:border-[#C85A17] transition-all duration-300 shadow-sm hover:shadow-lg flex flex-col justify-between group">
        <div>
          <div class="h-52 overflow-hidden relative">
            <img
              src="/images/rememberance_01_.jpg"
              alt="Templepatrick War Memorial Wreaths"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-3 left-3 px-3 py-1 bg-[#C85A17] text-white text-[10px] uppercase font-bold tracking-wider rounded">
              Digital Memorial
            </span>
          </div>
          <div class="p-6 space-y-3">
            <h3 class="font-serif text-xl font-bold text-[#1A1A1E] group-hover:text-[#C85A17] transition-colors">
              Roll of Honour
            </h3>
            <p class="text-xs text-[#5A5A62] leading-relaxed">
              A respectful, searchable digital remembrance archive honoring local servicemen and women from World War I, World War II, and local service.
            </p>
          </div>
        </div>

        <div class="px-6 pb-6 pt-2">
          <a
            href="/roll-of-honour"
            class="inline-flex items-center text-xs font-bold uppercase tracking-wider text-[#C85A17] hover:text-[#A64710] gap-1.5"
          >
            <span>Search Service Personnel</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Card 3: Hall Hire -->
      <div class="bg-white border border-[#E4E4E8] rounded-lg overflow-hidden hover:border-[#C85A17] transition-all duration-300 shadow-sm hover:shadow-lg flex flex-col justify-between group">
        <div>
          <div class="h-52 overflow-hidden relative">
            <img
              src="/images/hall.jpg"
              alt="Templepatrick War Memorial Hall"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-3 left-3 px-3 py-1 bg-[#1A1A1E] text-white text-[10px] uppercase font-bold tracking-wider rounded">
              Venue Hire
            </span>
          </div>
          <div class="p-6 space-y-3">
            <h3 class="font-serif text-xl font-bold text-[#1A1A1E] group-hover:text-[#C85A17] transition-colors">
              War Memorial Hall Hire
            </h3>
            <p class="text-xs text-[#5A5A62] leading-relaxed">
              Function hall facility with seating for up to 160 guests, equipped kitchen, stage AV setup, step-free access, and on-site parking.
            </p>
          </div>
        </div>

        <div class="px-6 pb-6 pt-2">
          <a
            href="/hall-hire"
            class="inline-flex items-center text-xs font-bold uppercase tracking-wider text-[#C85A17] hover:text-[#A64710] gap-1.5"
          >
            <span>View Specs & Book</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Photo Gallery Showcase - Culture, Music & Community -->
  <section class="py-16 bg-[#141417] text-white border-y border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-xs uppercase tracking-widest text-[#C85A17] font-bold">
            Photographic Archive
          </span>
          <h2 class="font-serif text-3xl md:text-4xl font-bold text-white mt-1">
            Culture, Music & Local Heritage
          </h2>
          <p class="text-xs text-gray-400 mt-1 max-w-xl">
            Moments capturing traditional pageantry, musical excellence, and charitable service in Templepatrick and District.
          </p>
        </div>
        <a href="/history" class="text-xs uppercase font-semibold text-[#C85A17] hover:text-white transition-colors">
          Explore History Collection →
        </a>
      </div>

      <!-- Real Photo Gallery Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="group relative rounded-lg overflow-hidden border border-gray-800 bg-[#1A1A1E]">
          <img src="/images/Templepatrick_banner_1.jpg" alt="Templepatrick L.O.L. Banner" class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="p-3 bg-[#1A1A1E] text-xs">
            <p class="font-serif font-bold text-white">Templepatrick L.O.L. 466 Banner</p>
            <p class="text-[11px] text-gray-400">Traditional Hand-Painted Lodge Banner</p>
          </div>
        </div>

        <div class="group relative rounded-lg overflow-hidden border border-gray-800 bg-[#1A1A1E]">
          <img src="/images/mojor_sinclair_memorial_pipe_band.jpg" alt="Major Sinclair Memorial Pipe Band" class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="p-3 bg-[#1A1A1E] text-xs">
            <p class="font-serif font-bold text-white">Major Sinclair Pipe Band</p>
            <p class="text-[11px] text-gray-400">Musical Tradition & Pageantry</p>
          </div>
        </div>

        <div class="group relative rounded-lg overflow-hidden border border-gray-800 bg-[#1A1A1E]">
          <img src="/images/arch.jpg" alt="Templepatrick Orange Arch" class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="p-3 bg-[#1A1A1E] text-xs">
            <p class="font-serif font-bold text-white">District Orange Arch</p>
            <p class="text-[11px] text-gray-400">Annual Cultural Celebrations</p>
          </div>
        </div>

        <div class="group relative rounded-lg overflow-hidden border border-gray-800 bg-[#1A1A1E]">
          <img src="/images/Macmillan_cancer)support.jpg" alt="Macmillan Charity Support" class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="p-3 bg-[#1A1A1E] text-xs">
            <p class="font-serif font-bold text-white">Community & Charity Work</p>
            <p class="text-[11px] text-gray-400">Supporting Local Causes & Health</p>
          </div>
        </div>

      </div>

    </div>
  </section>

</Layout>
