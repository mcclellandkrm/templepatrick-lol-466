---
import Layout from '../layouts/Layout.astro';
import RollOfHonourFilter from '../components/RollOfHonourFilter.astro';
---

<Layout
  title="Roll of Honour | Templepatrick L.O.L. No. 466"
  description="Digital remembrance registry honoring service personnel of Templepatrick & District."
  currentPath="/roll-of-honour"
>

  <!-- Page Header Banner with Real Remembrance Photography -->
  <section class="relative bg-[#141417] text-white py-16 md:py-24 border-b border-[#C85A17]/30 overflow-hidden">
    <div class="absolute inset-0 opacity-25">
      <img src="/images/rememberance_01_.jpg" alt="Templepatrick War Memorial Wreaths" class="w-full h-full object-cover object-center" />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-4 text-center md:text-left">
      <div class="inline-block px-3 py-1 bg-[#C85A17]/20 border border-[#C85A17]/40 text-[#C85A17] text-xs font-semibold uppercase tracking-widest rounded">
        Digital Remembrance Archive
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-white">
        Roll of Honour
      </h1>
      <p class="text-base md:text-lg text-gray-300 max-w-3xl font-light">
        In grateful memory of the brethren, servicemen, and women of Templepatrick & District who answered the call of duty.
      </p>
    </div>
  </section>

  <!-- Real Photo Remembrance Banner -->
  <section class="bg-[#1A1A1E] text-white py-10 border-b border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        
        <div class="md:col-span-4 rounded-lg overflow-hidden border border-gray-800 shadow-md">
          <img src="/images/memorial_photo.jpg" alt="War Memorial Stone Plaque" class="w-full h-48 object-cover" />
        </div>

        <div class="md:col-span-8 space-y-3 text-center md:text-left">
          <div class="w-12 h-0.5 bg-[#C85A17] mx-auto md:mx-0"></div>
          <p class="font-serif italic text-xl md:text-2xl text-gray-200">
            "At the going down of the sun and in the morning, we will remember them."
          </p>
          <p class="text-xs text-gray-400">
            Templepatrick War Memorial Orange Hall • Dedicated to Local Service Personnel
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Main Filterable Grid Container -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <RollOfHonourFilter />
  </section>

</Layout>
