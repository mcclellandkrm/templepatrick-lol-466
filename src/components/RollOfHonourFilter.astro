---
import rollData from '../data/rollOfHonour.json';
---

<div class="space-y-8">
  
  <!-- Search & Filter Control Bar -->
  <div class="bg-white border border-[#E4E4E8] rounded-lg p-6 shadow-sm space-y-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      
      <!-- Search Input -->
      <div class="relative flex-1">
        <svg class="w-5 h-5 absolute left-3.5 top-3.5 text-[#5A5A62]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          type="text"
          id="honour-search"
          placeholder="Search by name, rank, regiment, or service details..."
          class="w-full pl-11 pr-4 py-3 rounded border border-[#E4E4E8] bg-[#F9F9FB] text-sm text-[#1A1A1E] focus:outline-none focus:border-[#C85A17] focus:ring-1 focus:ring-[#C85A17] transition-all"
        />
      </div>

      <!-- Conflict Category Tabs -->
      <div class="flex flex-wrap items-center gap-1.5" id="conflict-tabs">
        <button
          data-category="all"
          class="tab-btn active px-4 py-2 text-xs font-semibold uppercase tracking-wider rounded transition-all bg-[#1A1A1E] text-white"
        >
          All Conflicts
        </button>
        <button
          data-category="World War I"
          class="tab-btn px-4 py-2 text-xs font-semibold uppercase tracking-wider rounded transition-all bg-[#F0F0F4] text-[#1A1A1E] hover:bg-[#C85A17] hover:text-white"
        >
          World War I
        </button>
        <button
          data-category="World War II"
          class="tab-btn px-4 py-2 text-xs font-semibold uppercase tracking-wider rounded transition-all bg-[#F0F0F4] text-[#1A1A1E] hover:bg-[#C85A17] hover:text-white"
        >
          World War II
        </button>
        <button
          data-category="Home Service"
          class="tab-btn px-4 py-2 text-xs font-semibold uppercase tracking-wider rounded transition-all bg-[#F0F0F4] text-[#1A1A1E] hover:bg-[#C85A17] hover:text-white"
        >
          Home Service
        </button>
      </div>

    </div>

    <!-- Active Count Display -->
    <div class="text-xs text-[#5A5A62] pt-2 border-t border-[#E4E4E8] flex justify-between items-center">
      <span>Honouring <strong id="record-count" class="text-[#1A1A1E] font-bold">{rollData.length}</strong> local service personnel</span>
      <span class="italic text-[11px]">"Lest We Forget"</span>
    </div>
  </div>

  <!-- Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="honour-grid">
    {rollData.map((person) => (
      <div
        class="honour-card bg-white border border-[#E4E4E8] hover:border-[#C85A17] rounded-lg p-6 transition-all duration-300 shadow-sm hover:shadow-md flex flex-col justify-between"
        data-name={person.name.toLowerCase()}
        data-regiment={person.regiment.toLowerCase()}
        data-citation={person.citation.toLowerCase()}
        data-conflict={person.conflict}
      >
        <div>
          <div class="flex items-start justify-between gap-3 mb-3">
            <div>
              <span class="inline-block text-[11px] uppercase tracking-widest font-semibold text-[#C85A17] bg-[#FDF6F0] px-2.5 py-0.5 rounded border border-[#C85A17]/20 mb-1.5">
                {person.conflict}
              </span>
              <h3 class="font-serif text-xl font-bold text-[#1A1A1E]">
                {person.name}
              </h3>
              <p class="text-xs font-medium text-[#5A5A62]">
                {person.rank} • {person.regiment}
              </p>
            </div>
            
            <div class="shrink-0 text-right">
              <span class="inline-block px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded bg-[#1A1A1E] text-white">
                {person.status}
              </span>
            </div>
          </div>

          <div class="space-y-2 py-3 my-2 border-y border-[#F0F0F4] text-xs text-[#1A1A1E]">
            <div class="flex justify-between">
              <span class="text-[#5A5A62]">Period of Service:</span>
              <span class="font-semibold">{person.years}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-[#5A5A62]">Local Residence:</span>
              <span class="font-semibold">{person.location}</span>
            </div>
          </div>

          <div class="mt-3">
            <p class="text-xs text-[#5A5A62] leading-relaxed italic border-l-2 border-[#C85A17] pl-3 py-1 bg-[#F9F9FB]">
              "{person.citation}"
            </p>
          </div>
        </div>

        <div class="mt-5 pt-3 border-t border-[#F0F0F4] flex items-center justify-between text-[11px]">
          <span class="text-[#C85A17] font-semibold flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-2h2v2zm0-4H9V5h2v4z"/>
            </svg>
            Templepatrick Digital Memorial Record
          </span>
          <span class="text-[#5A5A62]">L.O.L. 466 Registry</span>
        </div>
      </div>
    ))}
  </div>

  <!-- Empty Search Results -->
  <div id="no-results" class="hidden text-center py-16 bg-white border border-[#E4E4E8] rounded-lg p-8">
    <svg class="w-12 h-12 text-[#5A5A62] mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
    <h4 class="font-serif text-lg font-bold text-[#1A1A1E]">No records matching your search</h4>
    <p class="text-xs text-[#5A5A62] mt-1">Try adjusting your search terms or clearing conflict filters.</p>
  </div>
</div>

<script>
  const searchInput = document.getElementById('honour-search') as HTMLInputElement | null;
  const tabButtons = document.querySelectorAll('.tab-btn');
  const cards = document.querySelectorAll('.honour-card');
  const recordCount = document.getElementById('record-count');
  const noResults = document.getElementById('no-results');

  let activeCategory = 'all';

  function filterCards() {
    const query = searchInput?.value.toLowerCase().trim() || '';
    let visibleCount = 0;

    cards.forEach((card) => {
      const name = card.getAttribute('data-name') || '';
      const regiment = card.getAttribute('data-regiment') || '';
      const citation = card.getAttribute('data-citation') || '';
      const conflict = card.getAttribute('data-conflict') || '';

      const matchesSearch = !query || name.includes(query) || regiment.includes(query) || citation.includes(query);
      const matchesCategory = activeCategory === 'all' || conflict === activeCategory;

      if (matchesSearch && matchesCategory) {
        (card as HTMLElement).style.display = 'flex';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (recordCount) {
      recordCount.textContent = visibleCount.toString();
    }

    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  searchInput?.addEventListener('input', filterCards);

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabButtons.forEach((b) => {
        b.classList.remove('bg-[#1A1A1E]', 'text-white');
        b.classList.add('bg-[#F0F0F4]', 'text-[#1A1A1E]');
      });
      btn.classList.remove('bg-[#F0F0F4]', 'text-[#1A1A1E]');
      btn.classList.add('bg-[#1A1A1E]', 'text-white');

      activeCategory = btn.getAttribute('data-category') || 'all';
      filterCards();
    });
  });
</script>
