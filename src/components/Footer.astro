---
---

<footer class="bg-[#141417] text-[#FAF9F6] border-t border-[#C85A17]/30 pt-16 pb-12 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Upper Grid Section -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-gray-800">
      
      <!-- Brand & Mission (5 cols) -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-sm bg-[#C85A17] text-white flex items-center justify-center font-serif font-bold text-lg">
            466
          </div>
          <div>
            <h3 class="font-serif text-xl font-bold tracking-tight text-white">
              Templepatrick L.O.L. No. 466
            </h3>
            <p class="text-xs uppercase tracking-widest text-gray-400">
              County Antrim • Established 1923
            </p>
          </div>
        </div>
        
        <p class="text-gray-300 text-sm leading-relaxed pr-4">
          Preserving the history, heritage, and sacrifice of Templepatrick and the Six Mile Water district. Dedicated to brotherhood, community service, and remembrance.
        </p>

        <!-- Quote Callout Box -->
        <div class="p-4 rounded-sm bg-[#1A1A1E] border-l-2 border-[#C85A17] text-xs text-gray-300 italic font-serif leading-relaxed shadow-inner">
          "These do not need our praise or tears;<br/>
          They are too high for our low praise;<br/>
          In equal rank with standard-bearers;<br/>
          Of all the world's heroic days."
        </div>
      </div>

      <!-- Navigation Links (3 cols) -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-xs uppercase tracking-widest text-[#C85A17] font-semibold font-serif">
          Quick Navigation
        </h4>
        <ul class="space-y-2 text-sm text-gray-300">
          <li>
            <a href="/" class="hover:text-[#C85A17] transition-colors flex items-center gap-1.5">
              <span>›</span> Home Overview
            </a>
          </li>
          <li>
            <a href="/history" class="hover:text-[#C85A17] transition-colors flex items-center gap-1.5">
              <span>›</span> History & Heritage
            </a>
          </li>
          <li>
            <a href="/roll-of-honour" class="hover:text-[#C85A17] transition-colors flex items-center gap-1.5">
              <span>›</span> Roll of Honour
            </a>
          </li>
          <li>
            <a href="/hall-hire" class="hover:text-[#C85A17] transition-colors flex items-center gap-1.5">
              <span>›</span> Hall Hire & Facilities
            </a>
          </li>
          <li>
            <a href="/members" class="hover:text-[#C85A17] transition-colors flex items-center gap-1.5">
              <span>›</span> Members Login Portal
            </a>
          </li>
        </ul>
      </div>

      <!-- Location & Contact Info (4 cols) -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="text-xs uppercase tracking-widest text-[#C85A17] font-semibold font-serif">
          Hall Location & Inquiries
        </h4>
        <div class="space-y-2.5 text-sm text-gray-300">
          <div class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-[#C85A17] shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>
              <strong>Templepatrick War Memorial Hall</strong><br/>
              Antrim Road, Templepatrick<br/>
              Ballyclare, Co. Antrim, BT39 0AP
            </span>
          </div>
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-[#C85A17] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span class="text-gray-300">info@templepatricklol466.org</span>
          </div>
          <div class="pt-2">
            <a
              href="/hall-hire#booking-section"
              class="inline-block px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white bg-[#C85A17] hover:bg-[#A64710] rounded transition-all"
            >
              Contact Convenor
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Credit -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-gray-400 gap-4">
      <p>© {new Date().getFullYear()} Templepatrick Loyal Orange Lodge No. 466. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <span>Editorial & Cultural Heritage Archive</span>
        <span>•</span>
        <a href="/members" class="hover:text-white transition-colors">Member Access</a>
      </div>
    </div>

  </div>
</footer>
