---
---

<div class="max-w-4xl mx-auto">
  
  <!-- Login State Container -->
  <div id="login-view" class="bg-white border border-[#E4E4E8] rounded-lg p-6 md:p-12 shadow-sm">
    <div class="max-w-md mx-auto text-center space-y-6">
      
      <!-- Emblem & Title -->
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-[#1A1A1E] text-white border-2 border-[#C85A17] font-serif font-bold text-2xl shadow-md mx-auto">
        466
      </div>

      <div>
        <h2 class="font-serif text-2xl md:text-3xl font-bold text-[#1A1A1E]">
          Lodge Member Portal
        </h2>
        <p class="text-xs text-[#5A5A62] uppercase tracking-widest mt-1.5 font-semibold">
          Templepatrick Loyal Orange Lodge No. 466
        </p>
      </div>

      <!-- Login Form -->
      <form id="member-login-form" class="space-y-4 text-left pt-2">
        <div id="login-error" class="hidden p-3 rounded bg-red-50 text-red-700 text-xs font-medium border border-red-200"></div>

        <div>
          <label for="lodgeNumber" class="block text-xs font-semibold uppercase tracking-wider text-[#1A1A1E] mb-1.5">
            Lodge Number
          </label>
          <input
            type="text"
            id="lodgeNumber"
            value="466"
            readonly
            class="w-full px-4 py-3 rounded border border-[#E4E4E8] bg-[#F0F0F4] text-sm text-[#1A1A1E] font-semibold cursor-not-allowed"
          />
        </div>

        <div>
          <label for="memberId" class="block text-xs font-semibold uppercase tracking-wider text-[#1A1A1E] mb-1.5">
            Member Certificate ID / Passcode
          </label>
          <input
            type="password"
            id="memberId"
            required
            placeholder="Enter member credentials (e.g. 466-MEMBERS)"
            class="w-full px-4 py-3 rounded border border-[#E4E4E8] bg-[#F9F9FB] text-sm text-[#1A1A1E] focus:outline-none focus:border-[#C85A17] focus:ring-1 focus:ring-[#C85A17] transition-all"
          />
        </div>

        <div class="flex items-center justify-between text-xs pt-1">
          <label class="flex items-center gap-2 cursor-pointer text-[#5A5A62]">
            <input type="checkbox" checked class="accent-[#C85A17] rounded" />
            <span>Remember session on this device</span>
          </label>
          <a href="#demo-hint" id="demo-hint-btn" class="text-[#C85A17] hover:underline font-medium">Demo Login Hint</a>
        </div>

        <div class="pt-3">
          <button
            type="submit"
            class="w-full py-3.5 bg-[#1A1A1E] hover:bg-[#C85A17] text-white font-semibold uppercase tracking-wider text-xs rounded transition-all shadow-sm flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
            </svg>
            <span>Authenticate Member Access</span>
          </button>
        </div>
      </form>

      <div class="pt-4 border-t border-[#F0F0F4] text-[11px] text-[#5A5A62]">
        <p>This portal is restricted to registered brethren of L.O.L. No. 466.</p>
        <p class="mt-1">For access inquiries, contact the Lodge Secretary at the War Memorial Hall.</p>
      </div>

    </div>
  </div>

  <!-- Authenticated Dashboard View (Initially Hidden) -->
  <div id="dashboard-view" class="hidden space-y-8">
    
    <!-- Welcome Header Banner -->
    <div class="bg-[#141417] text-white p-6 md:p-8 rounded-lg border-l-4 border-[#C85A17] flex flex-col md:flex-row md:items-center justify-between gap-6 shadow-md">
      <div>
        <div class="flex items-center gap-2 text-xs uppercase tracking-widest text-[#C85A17] font-semibold mb-1">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Member Authenticated
        </div>
        <h3 class="font-serif text-2xl md:text-3xl font-bold">
          Welcome Brethren
        </h3>
        <p class="text-xs text-gray-300 mt-1">
          Templepatrick Loyal Orange Lodge No. 466 • Internal Notice Board
        </p>
      </div>

      <button
        id="logout-btn"
        class="px-4 py-2.5 bg-white/10 hover:bg-white/20 text-white text-xs uppercase tracking-wider font-semibold rounded border border-white/20 transition-all shrink-0 self-start md:self-auto"
      >
        Sign Out Portal
      </button>
    </div>

    <!-- Dashboard Content Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Next Meeting Card -->
      <div class="bg-white border border-[#E4E4E8] rounded-lg p-6 space-y-4 shadow-sm">
        <div class="flex items-center justify-between">
          <h4 class="font-serif font-bold text-lg text-[#1A1A1E]">Next Regular Meeting</h4>
          <span class="w-3 h-3 rounded-full bg-[#C85A17]"></span>
        </div>
        <div class="p-4 bg-[#FDF6F0] border border-[#C85A17]/30 rounded">
          <p class="text-xs uppercase tracking-widest text-[#C85A17] font-bold">Tuesday 2nd September 2026</p>
          <p class="font-serif font-bold text-xl text-[#1A1A1E] mt-1">7:30 PM Prompt</p>
          <p class="text-xs text-[#5A5A62] mt-1">Templepatrick War Memorial Orange Hall</p>
        </div>
        <ul class="text-xs space-y-2 text-[#1A1A1E]">
          <li class="flex justify-between border-b border-[#F0F0F4] pb-1.5">
            <span class="text-[#5A5A62]">Order of Business:</span>
            <span class="font-semibold">District Reports & Hall Business</span>
          </li>
          <li class="flex justify-between border-b border-[#F0F0F4] pb-1.5">
            <span class="text-[#5A5A62]">Dress Code:</span>
            <span class="font-semibold">Dark Suit & Regalia</span>
          </li>
        </ul>
      </div>

      <!-- Internal Announcements Card -->
      <div class="bg-white border border-[#E4E4E8] rounded-lg p-6 space-y-4 shadow-sm">
        <h4 class="font-serif font-bold text-lg text-[#1A1A1E]">Internal Circulars</h4>
        <div class="space-y-3">
          <div class="p-3 bg-[#F9F9FB] border-l-2 border-[#C85A17] rounded text-xs space-y-1">
            <div class="flex justify-between font-bold text-[#1A1A1E]">
              <span>Six Mile Water Cultural Lecture</span>
              <span class="text-[10px] text-[#5A5A62]">10 Aug</span>
            </div>
            <p class="text-[#5A5A62]">Historical symposium on 18th century turnpike roads scheduled for late September.</p>
          </div>
          <div class="p-3 bg-[#F9F9FB] border-l-2 border-[#1A1A1E] rounded text-xs space-y-1">
            <div class="flex justify-between font-bold text-[#1A1A1E]">
              <span>War Memorial Restoration Works</span>
              <span class="text-[10px] text-[#5A5A62]">02 Aug</span>
            </div>
            <p class="text-[#5A5A62]">Phase 2 pointing and masonry polish complete. All brethren thanked for contributions.</p>
          </div>
        </div>
      </div>

      <!-- Member Downloads Card -->
      <div class="bg-white border border-[#E4E4E8] rounded-lg p-6 space-y-4 shadow-sm">
        <h4 class="font-serif font-bold text-lg text-[#1A1A1E]">Lodge Resources</h4>
        <div class="space-y-2 text-xs">
          <a href="#" class="flex items-center justify-between p-3 rounded border border-[#E4E4E8] hover:border-[#C85A17] hover:bg-[#FDF6F0] transition-all">
            <span class="font-medium text-[#1A1A1E]">Monthly Meeting Agenda (PDF)</span>
            <svg class="w-4 h-4 text-[#C85A17]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </a>
          <a href="#" class="flex items-center justify-between p-3 rounded border border-[#E4E4E8] hover:border-[#C85A17] hover:bg-[#FDF6F0] transition-all">
            <span class="font-medium text-[#1A1A1E]">Hall Hire Bye-Laws & Rules</span>
            <svg class="w-4 h-4 text-[#C85A17]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </a>
          <a href="#" class="flex items-center justify-between p-3 rounded border border-[#E4E4E8] hover:border-[#C85A17] hover:bg-[#FDF6F0] transition-all">
            <span class="font-medium text-[#1A1A1E]">Roll of Officers 2026</span>
            <svg class="w-4 h-4 text-[#C85A17]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>

</div>

<script>
  const loginForm = document.getElementById('member-login-form') as HTMLFormElement | null;
  const loginView = document.getElementById('login-view');
  const dashboardView = document.getElementById('dashboard-view');
  const logoutBtn = document.getElementById('logout-btn');
  const demoBtn = document.getElementById('demo-hint-btn');
  const memberInput = document.getElementById('memberId') as HTMLInputElement | null;

  if (demoBtn && memberInput) {
    demoBtn.addEventListener('click', (e) => {
      e.preventDefault();
      memberInput.value = '466-BRETHREN';
    });
  }

  if (loginForm && loginView && dashboardView) {
    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      loginView.classList.add('hidden');
      dashboardView.classList.remove('hidden');
      window.scrollTo({ top: dashboardView.offsetTop - 100, behavior: 'smooth' });
    });
  }

  if (logoutBtn && loginView && dashboardView) {
    logoutBtn.addEventListener('click', () => {
      dashboardView.classList.add('hidden');
      loginView.classList.remove('hidden');
      if (memberInput) memberInput.value = '';
    });
  }
</script>
